{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "tools/typecheck/embed-shims.d.ts",
    "src/App.jsx",
    "src/embed/cardUi.js",
    "src/embed/core.jsx",
    "src/embed/kinds.js",
    "src/embed/index.js",
    "src/embed/mount.js",
    "src/embed/shadowCss.js",
    "src/shell/viewState.js",
    "src/shell/env.js",
    "src/shell/LangContext.jsx",
    "src/theme/ThemeContext.jsx",
    "src/shell/prefs.js",
    "src/shell/printHost.js",
    "src/theme/themes.js",
    "src/theme/themeTokens.js",
    "src/shell/printPaper.js",
    "src/shell/ErrorBoundary.jsx",
    "src/shell/hostAttrs.js",
    "src/shell/DockParts.jsx",
    "src/shell/useSelectEvent.js",
    "src/shell/chromeInsets.js",
    "src/shell/dockPlace.js",
    "src/shell/useExport.js",
    "src/shell/startupError.js",
    "src/shell/exportPng.js"
  ]
}
