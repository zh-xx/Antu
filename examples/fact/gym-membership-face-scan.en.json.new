          "label": "Receives the \"no face scan, no entry\" message",
          "summary": "Fingerprint check cancelled",
          "groupId": "g-2",
          "actorIds": [
            "a-1"
          ],
          "detail": "The Example Fitness Club texted all members: the membership system now admits by face scan, the fingerprint check is cancelled, and from today members whose face is not registered cannot enter",
