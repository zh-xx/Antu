            "s-5"
          ]
        }
      ]
    },
    {
      "events": [
        {
          "id": "ev-6",
          "date": "2030-08-26",
          "label": "Goes to the club, asks for a refund, gets none",
          "summary": "Asks for his fee back, no agreement",
          "groupId": "g-2",
          "actorIds": [
            "a-1"
          ],
          "detail": "Han Lei went to the club to check the face-scan rule; the front desk said the fingerprint way no longer worked and that without a registered face he could not get in; Han Lei said his family did not agree to face recognition and asked about a refund, and no agreement was reached; that day Han Lei did not ask to enter and did not register his face",
          "sourceIds": [
            "s-6"
          ]
        }
      ]
    },
    {
      "events": [
        {
          "id": "ev-7",
          "date": "2030-09-04",
          "label": "States his position to the press",
          "summary": "\"Fingerprint yes, face no\"",
          "groupId": "g-2",
          "actorIds": [
            "a-1"
          ],
          "detail": "The Example Evening News printed Han Lei's view: \"I agree to a fingerprint; I do not agree to a face scan\". Afterwards Han Lei did not enter with \"card plus ID\"",
