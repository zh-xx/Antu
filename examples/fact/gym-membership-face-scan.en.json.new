{
  "specVersion": 2,
  "type": "fact",
  "title": "Han Lei's side · How the way into the gym changed (fictional: face scan at a gym, one party)",
  "actors": [
    {
      "id": "a-1",
      "name": "Han Lei",
      "role": "Plaintiff"
    }
  ],
  "groups": [
    {
      "id": "g-1",
      "label": "Normal (performed as agreed)"
    },
    {
      "id": "g-2",
      "label": "Abnormal (departs from the agreement)"
    },
    {
      "id": "g-3",
      "label": "Objective course (no party involved)"
    }
  ],
  "sources": [
    {
      "id": "s-1",
      "type": "contract",
      "name": "One-year membership agreement",
      "loc": {
        "file": "Membership agreement",
        "clause": 2
      },
      "quote": "A member enters by showing the membership card and verifying a fingerprint"
    },
    {
      "id": "s-2",
      "type": "evidence",
      "name": "Mobile payment bill",
      "loc": {
        "file": "Payment bill"
      },
      "quote": "On 10 February 2030 Han Lei paid the Example Fitness Club a membership fee of 2,400 yuan by mobile payment"
    },
    {
      "id": "s-3",
      "type": "evidence",
      "name": "Member entry record",
      "loc": {
        "file": "Entry record"
      },
      "quote": "After Han Lei took out the membership the card was used on 10 February, 17 February, 3 March and 18 May 2030, four entries in all"
    },
    {
      "id": "s-4",
      "type": "evidence",
      "name": "Text message (12 June 2030)",
      "loc": {
        "file": "Text message"
      },
      "quote": "The membership system has been upgraded and you can now enter by face scan; members who have not yet activated their face should bring the card to the front desk"
    },
    {
      "id": "s-5",
      "type": "evidence",
      "name": "Text message (17 August 2030)",
      "loc": {
        "file": "Text message"
      },
      "quote": "The club's membership system now admits by face scan and fingerprint verification is cancelled; from today members whose face is not registered cannot enter"
    },
    {
      "id": "s-6",
      "type": "evidence",
      "name": "Han Lei's phone video (26 August 2030)",
      "loc": {
        "file": "Phone video"
      },
      "quote": "The front desk said the fingerprint way no longer works and that without a registered face he could not get in; Han Lei said his family did not agree to face recognition and asked whether he could get his fee back without registering"
    },
    {
      "id": "s-7",
      "type": "document",
      "name": "Example Evening News report (4 September 2030)",
      "loc": {
        "file": "Example Evening News, e-edition",
        "page": 2
      },
      "quote": "I agree to a fingerprint; I do not agree to a face scan"
    },
    {
      "id": "s-8",
      "type": "case",
      "name": "First-instance judgment in this case (fictional)",
      "loc": {
        "caseNo": "(2031) Shi Min Chu No. 2",
        "court": "Example District People's Court, Example City, Example Province"
      },
      "meta": {
        "level": "First instance",
        "docType": "Judgment"
      },
      "quote": "Without discussing it with Han Lei or obtaining his consent, the club sent a message saying that without a registered face he could not enter … this is an express statement that a main obligation of the contract will not be performed"
    }
  ],
