{
  "specVersion": 1,
  "type": "justification",
  "title": "方远案（虚构） · 防卫过当的说理",
  "speaker": "示例省高级人民法院（二审，虚构）",
  "groups": [
    {
      "id": "g-1",
      "label": "争点一：是否具有防卫性"
    },
    {
      "id": "g-2",
      "label": "争点二：是否属于特殊防卫"
    },
    {
      "id": "g-3",
      "label": "争点三：是否明显超过必要限度"
    },
    {
      "id": "g-4",
      "label": "争点四：定什么罪"
    },
    {
      "id": "g-5",
      "label": "争点五：如何量刑"
    }
  ],
  "nodes": [
    {
      "id": "c-1",
      "kind": "conclusion",
      "label": "防卫过当，构成故意伤害罪，判处有期徒刑四年",
      "holds": "yes"
    },
    {
      "id": "c-2",
      "kind": "conclusion",
      "label": "方远的捅刺行为具有防卫性",
      "holds": "yes",
      "combine": "all",
      "groupId": "g-1"
    },
    {
      "id": "n-1",
      "kind": "norm",
      "label": "示意条款甲第 1 款：正当防卫须同时具备五项条件（防卫限度见争点三）",
      "groupId": "g-1",
      "sourceIds": [
        "s-3"
      ]
    },
    {
      "id": "e-1",
      "kind": "element",
      "label": "起因：不法侵害客观存在",
      "holds": "yes",
      "groupId": "g-1"
    },
    {
      "id": "e-2",
      "kind": "element",
      "label": "时间：不法侵害正在进行",
      "holds": "yes",
      "groupId": "g-1"
    },
    {
      "id": "e-3",
      "kind": "element",
      "label": "对象：针对不法侵害者本人",
      "holds": "yes",
      "groupId": "g-1"
    },
    {
      "id": "e-4",
      "kind": "element",
      "label": "意图：为制止不法侵害",
      "holds": "yes",
      "groupId": "g-1"
    },
    {
      "id": "f-1",
      "kind": "fact",
      "label": "姜某等人进入接待室讨债，收走梁某、方远的手机",
      "date": "2032-04-14T21:53",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-2",
      "kind": "fact",
      "label": "姜某辱骂梁某、方远及家人；将烟头弹到梁某胸前；褪裤裸露下体；脱方远的鞋让梁某闻",
      "date": "2032-04-14",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-3",
      "kind": "fact",
      "label": "姜某拍打方远面颊；其他讨债人员揪抓方远头发、按压其肩部不准起身",
      "date": "2032-04-14",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-4",
      "kind": "fact",
      "label": "钟某责骂梁某，将梁某推倒在地并踩住其手臂",
      "date": "2032-04-13",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-5",
      "kind": "fact",
      "label": "此前钟某、郑某指使姜某等人在远华公司车棚驻扎、办公楼前支锅做饭等方式催债",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-6",
      "kind": "fact",
      "label": "民警警告双方不能打架后，带辅警离开接待室去院内寻找报警人",
      "date": "2032-04-14T22:22",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-7",
      "kind": "fact",
      "label": "方远、梁某想随民警离开，姜某等人阻拦，并强迫方远坐下",
      "date": "2032-04-14",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-8",
      "kind": "fact",
      "label": "姜某等人卡方远颈部，将其推拉至接待室东南角",
      "date": "2032-04-14",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-9",
      "kind": "fact",
      "label": "方远持刃长 12 厘米的水果刀，警告姜某等人不要靠近；姜某出言挑衅并逼近",
      "date": "2032-04-14",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-10",
      "kind": "fact",
      "label": "方远捅刺姜某腹部，又各捅刺围逼在身边的程某胸部、严某腹部、孟某背部一刀",
      "date": "2032-04-14",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "c-3",
      "kind": "conclusion",
      "label": "属于特殊防卫，不负刑事责任",
      "holds": "no",
      "groupId": "g-2"
    },
    {
      "id": "n-2",
      "kind": "norm",
      "label": "示意条款甲第 3 款：对正在进行的行凶、杀人、抢劫、强奸、绑架等严重危及人身安全的暴力犯罪防卫，不属于防卫过当",
      "groupId": "g-2",
      "sourceIds": [
        "s-3"
      ]
    },
    {
      "id": "e-5",
      "kind": "element",
      "label": "正在进行严重危及人身安全的暴力犯罪",
      "holds": "no",
      "groupId": "g-2"
    },
    {
      "id": "j-1",
      "kind": "judgement",
      "label": "这些侵害是非法限制自由、侮辱、轻微殴打，不是严重危及人身安全的暴力犯罪",
      "holds": "yes",
      "groupId": "g-2",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "n-3",
      "kind": "norm",
      "label": "示意条款甲第 2 款：正当防卫明显超过必要限度造成重大损害的，应当负刑事责任",
      "groupId": "g-3",
      "sourceIds": [
        "s-3"
      ]
    },
    {
      "id": "e-6",
      "kind": "element",
      "label": "明显超过必要限度造成重大损害",
      "holds": "yes",
      "groupId": "g-3"
    },
    {
      "id": "j-2",
      "kind": "judgement",
      "label": "方远面临的侵害并不紧迫、不严重",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "i-1",
      "kind": "inference",
      "label": "姜某一方意图是施压催债，未携带、使用任何器械",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "i-2",
      "kind": "inference",
      "label": "民警进入时双方没有激烈对峙和肢体冲突；警告后对方无打架言行",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "i-3",
      "kind": "inference",
      "label": "警车警灯闪烁清晰可见，方远应当知道民警并未离开",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "i-4",
      "kind": "inference",
      "label": "姜某等人虽挑衅、围逼，但没有实施强烈的攻击行为",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-11",
      "kind": "fact",
      "label": "院内停着的警车警灯闪烁，接待室内透过玻璃可以看见",
      "date": "2032-04-14",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-3",
      "kind": "judgement",
      "label": "防卫手段与后果过重",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-12",
      "kind": "fact",
      "label": "捅刺造成一死、二重伤、一轻伤，其中一人被从背后捅伤；22 时 26 分辅警闻声返回",
      "date": "2032-04-14",
      "groupId": "g-3",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "c-4",
      "kind": "conclusion",
      "label": "构成防卫过当下的故意伤害罪，而非故意杀人罪",
      "holds": "yes",
      "groupId": "g-4"
    },
    {
      "id": "n-4",
      "kind": "norm",
      "label": "示意条款乙：故意伤害致人死亡的，适用较重的刑罚档次",
      "groupId": "g-4",
      "sourceIds": [
        "s-4"
      ]
    },
    {
      "id": "i-5",
      "kind": "inference",
      "label": "在案证据不能证实方远追求或放任致人死亡：每人一刀，不连刺同一人，只刺围逼者，目的是离开",
      "holds": "yes",
      "groupId": "g-4",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-4",
      "kind": "judgement",
      "label": "方远对过当的伤亡结果持听之任之的态度",
      "holds": "yes",
      "groupId": "g-4",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "c-5",
      "kind": "conclusion",
      "label": "对方远减轻处罚，判处有期徒刑四年",
      "holds": "yes",
      "groupId": "g-5"
    },
    {
      "id": "n-5",
      "kind": "norm",
      "label": "示意条款甲第 2 款：防卫过当，应当减轻或者免除处罚",
      "groupId": "g-5",
      "sourceIds": [
        "s-3"
      ]
    },
    {
      "id": "f-13",
      "kind": "fact",
      "label": "方远归案后如实供述主要罪行",
      "groupId": "g-5",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-5",
      "kind": "judgement",
      "label": "被害方对引发本案有严重过错",
      "holds": "yes",
      "groupId": "g-5",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-6",
      "kind": "judgement",
      "label": "损害远大于所保护的合法权益，且除姜某外另三人并未侮辱梁某",
      "holds": "yes",
      "groupId": "g-5",
      "sourceIds": [
        "s-2"
      ]
    }
  ],
