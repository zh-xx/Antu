{
  "specVersion": 1,
  "type": "justification",
  "title": "楼道充电劝阻案（虚构） · 二审改判的说理",
  "speaker": "示例市中级人民法院（二审，虚构）",
  "groups": [
    {
      "id": "g-1",
      "label": "争点一：孙浩是否应承担一般侵权责任"
    },
    {
      "id": "g-2",
      "label": "争点二：一审的公平责任能否适用"
    },
    {
      "id": "g-3",
      "label": "争点三：孙浩没有上诉，二审能否改判"
    }
  ],
  "nodes": [
    {
      "id": "c-1",
      "kind": "conclusion",
      "label": "撤销一审判决，驳回钱敏的诉讼请求：孙浩不承担侵权责任",
      "holds": "yes"
    },
    {
      "id": "n-5",
      "kind": "norm",
      "label": "示意条款丁第 1 款第 2 项：二审改判的依据",
      "sourceIds": [
        "s-6"
      ]
    },
    {
      "id": "c-2",
      "kind": "conclusion",
      "label": "孙浩应承担一般侵权责任（过错责任）",
      "holds": "no",
      "combine": "all",
      "groupId": "g-1"
    },
    {
      "id": "n-1",
      "kind": "norm",
      "label": "示意条款甲：行为人因过错侵害他人民事权益，应当承担侵权责任",
      "groupId": "g-1",
      "sourceIds": [
        "s-3"
      ]
    },
    {
      "id": "e-1",
      "kind": "element",
      "label": "劝阻行为不正当，超出了必要限度",
      "holds": "no",
      "groupId": "g-1"
    },
    {
      "id": "e-2",
      "kind": "element",
      "label": "劝阻行为与钱敏的心脏不适之间有法律上的因果关系",
      "holds": "no",
      "groupId": "g-1"
    },
    {
      "id": "e-3",
      "kind": "element",
      "label": "孙浩有故意或过失",
      "holds": "no",
      "groupId": "g-1"
    },
    {
      "id": "j-1",
      "kind": "judgement",
      "label": "孙浩的劝阻理性平和，未超出必要限度，属于正当劝阻",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-2",
      "kind": "judgement",
      "label": "劝阻与发病只有时间上的先后，没有法律上的因果关系",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-3",
      "kind": "judgement",
      "label": "孙浩劝阻充电是维护公共安全的正当行为，没有加害钱敏的故意",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "i-1",
      "kind": "inference",
      "label": "孙浩劝阻充电这一行为本身不会造成钱敏发病",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "i-2",
      "kind": "inference",
      "label": "孙浩对钱敏发病无法预见，也不存在疏忽或懈怠",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-1",
      "kind": "fact",
      "label": "楼道监控（时间显示 20 时 14 分）：钱敏在楼道内给电池充电，孙浩进入楼道后，双方开始交谈",
      "date": "2030-06-02",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-2",
      "kind": "fact",
      "label": "三段监控只有影像、没有声音；二人只有言语交流，无拉扯，无肢体接触",
      "date": "2030-06-02",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-3",
      "kind": "fact",
      "label": "孙浩在整个过程中语气平缓；钱敏语气急促，并随时间推移不断升高",
      "date": "2030-06-02",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-4",
      "kind": "fact",
      "label": "没有证据证明孙浩对钱敏有过呵斥或其他不当行为",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-5",
      "kind": "fact",
      "label": "孙浩与钱敏的接触时间不足 5 分钟",
      "date": "2030-06-02",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-6",
      "kind": "fact",
      "label": "20 时 21 分呼叫急救，急救人员 20 时 27 分到达患者身边",
      "date": "2030-06-02T20:21",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-7",
      "kind": "fact",
      "label": "孙浩此前不认识钱敏，也不知道钱敏的心脏病史",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-8",
      "kind": "fact",
      "label": "孙浩得知情况后，及时协助呼叫急救并陪同等候",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "c-3",
      "kind": "conclusion",
      "label": "应按公平原则，由孙浩补偿钱敏 8000 元（一审的做法）",
      "holds": "no",
      "groupId": "g-2"
    },
    {
      "id": "n-2",
      "kind": "norm",
      "label": "示意条款乙：受害人和行为人对损害的发生都没有过错的，可以根据实际情况，由双方分担损失",
      "groupId": "g-2",
      "sourceIds": [
        "s-4"
      ]
    },
    {
      "id": "e-4",
      "kind": "element",
      "label": "行为与损害结果之间有法律上的因果关系，且双方都没有过错",
      "holds": "no",
      "groupId": "g-2"
    },
    {
      "id": "j-4",
      "kind": "judgement",
      "label": "劝阻与发病之间没有法律上的因果关系，适用示意条款乙的前提不成立",
      "holds": "yes",
      "groupId": "g-2",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-5",
      "kind": "judgement",
      "label": "一审依示意条款乙适用公平原则判令孙浩补偿，属于适用法律错误",
      "holds": "yes",
      "groupId": "g-2",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-9",
      "kind": "fact",
      "label": "一审判决以钱敏在与孙浩发生言语争执后突发心脏不适为由，判令孙浩补偿钱敏 8000 元",
      "groupId": "g-2",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "c-4",
      "kind": "conclusion",
      "label": "二审应当对一审判决改判",
      "holds": "yes",
      "groupId": "g-3"
    },
    {
      "id": "n-3",
      "kind": "norm",
      "label": "示意条款丙：二审围绕上诉请求审理；但一审判决违反法律禁止性规定，或损害国家利益、社会公共利益、他人合法权益的除外",
      "groupId": "g-3",
      "sourceIds": [
        "s-5"
      ]
    },
    {
      "id": "n-4",
      "kind": "norm",
      "label": "示例市有关规定：楼道等公共场所禁止给电动车电池充电，居民有权制止",
      "groupId": "g-3",
      "sourceIds": [
        "s-7"
      ]
    },
    {
      "id": "n-6",
      "kind": "norm",
      "label": "民事规则的基本原则和立法宗旨（示意）：维护社会公共利益和公序良俗，弘扬良好社会风尚",
      "groupId": "g-3",
      "sourceIds": [
        "s-8"
      ]
    },
    {
      "id": "e-5",
      "kind": "element",
      "label": "一审判决损害社会公共利益（二审可不受上诉请求限制的例外）",
      "holds": "yes",
      "groupId": "g-3"
    },
    {
      "id": "j-6",
      "kind": "judgement",
      "label": "孙浩劝阻充电合法正当，是自觉维护楼道消防安全和公共利益的行为",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-7",
      "kind": "judgement",
      "label": "让正当劝阻的居民分担损失，会挫伤居民维护公共安全的积极性，损害社会公共利益，与立法宗旨相悖",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-10",
      "kind": "fact",
      "label": "一审判决作出后，孙浩没有上诉",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    }
  ],
