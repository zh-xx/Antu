{
  "specVersion": 1,
  "type": "justification",
  "title": "电梯劝烟案 · 二审改判的说理",
  "speaker": "河南省郑州市中级人民法院（二审）",
  "groups": [
    {
      "id": "g-1",
      "label": "争点一：杨帆是否应承担一般侵权责任"
    },
    {
      "id": "g-2",
      "label": "争点二：一审的公平责任能否适用"
    },
    {
      "id": "g-3",
      "label": "争点三：杨帆没有上诉，二审能否改判"
    }
  ],
  "nodes": [
    {
      "id": "c-1",
      "kind": "conclusion",
      "label": "撤销一审判决，驳回田九菊的诉讼请求：杨帆不承担侵权责任",
      "holds": "yes"
    },
    {
      "id": "n-5",
      "kind": "norm",
      "label": "民事诉讼法第 170 条第 1 款第 2 项：二审改判的依据",
      "sourceIds": [
        "s-6"
      ]
    },
    {
      "id": "c-2",
      "kind": "conclusion",
      "label": "杨帆应承担一般侵权责任（过错责任）",
      "holds": "no",
      "combine": "all",
      "groupId": "g-1"
    },
    {
      "id": "n-1",
      "kind": "norm",
      "label": "侵权责任法第 6 条第 1 款：行为人因过错侵害他人民事权益，应当承担侵权责任",
      "groupId": "g-1",
      "sourceIds": [
        "s-3"
      ]
    },
    {
      "id": "e-1",
      "kind": "element",
      "label": "劝阻行为不正当，超出了必要限度",
      "holds": "no",
      "groupId": "g-1"
    },
    {
      "id": "e-2",
      "kind": "element",
      "label": "劝阻行为与段小立的死亡之间有法律上的因果关系",
      "holds": "no",
      "groupId": "g-1"
    },
    {
      "id": "e-3",
      "kind": "element",
      "label": "杨帆有故意或过失",
      "holds": "no",
      "groupId": "g-1"
    },
    {
      "id": "j-1",
      "kind": "judgement",
      "label": "杨帆的劝阻理性平和，未超出必要限度，属于正当劝阻",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-2",
      "kind": "judgement",
      "label": "劝阻与死亡只有时间上的先后，没有法律上的因果关系",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-3",
      "kind": "judgement",
      "label": "杨帆劝阻吸烟是履行公民应尽的社会责任，没有加害段小立的故意",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "i-1",
      "kind": "inference",
      "label": "杨帆劝阻吸烟这一行为本身不会造成段小立死亡",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "i-2",
      "kind": "inference",
      "label": "杨帆对段小立的死亡无法预见，也不存在疏忽或懈怠",
      "holds": "yes",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-1",
      "kind": "fact",
      "label": "电梯间监控（时间显示 9 时 24 分）：段小立在电梯内吸烟，杨帆进入电梯后，双方开始语言交流",
      "date": "2017-05-02",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-2",
      "kind": "fact",
      "label": "三段监控只有影像、没有声音；二人只有语言交流，无拉扯行为，无肢体冲突",
      "date": "2017-05-02",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-3",
      "kind": "fact",
      "label": "杨帆在整个过程中情绪相对冷静、克制；段小立情绪较为激动，并随时间推移不断升级",
      "date": "2017-05-02",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-4",
      "kind": "fact",
      "label": "没有证据证明杨帆对段小立进行过呵斥或有其他不当行为",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-5",
      "kind": "fact",
      "label": "杨帆与段小立的接触时长不足 5 分钟",
      "date": "2017-05-02",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-6",
      "kind": "fact",
      "label": "9 时 31 分呼叫 120，急救人员 9 时 37 分到达患者身边",
      "date": "2017-05-02T09:31",
      "groupId": "g-1",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "f-7",
      "kind": "fact",
      "label": "杨帆此前不认识段小立，也不知道段小立的病史和心脏搭桥手术",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-8",
      "kind": "fact",
      "label": "杨帆得知情况后，及时发挥专业技能对段小立积极施救",
      "groupId": "g-1",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "c-3",
      "kind": "conclusion",
      "label": "应按公平原则，由杨帆补偿田九菊 15000 元（一审的做法）",
      "holds": "no",
      "groupId": "g-2"
    },
    {
      "id": "n-2",
      "kind": "norm",
      "label": "侵权责任法第 24 条：受害人和行为人对损害的发生都没有过错的，可以根据实际情况，由双方分担损失",
      "groupId": "g-2",
      "sourceIds": [
        "s-4"
      ]
    },
    {
      "id": "e-4",
      "kind": "element",
      "label": "行为与损害结果之间有法律上的因果关系，且双方都没有过错",
      "holds": "no",
      "groupId": "g-2"
    },
    {
      "id": "j-4",
      "kind": "judgement",
      "label": "劝阻与死亡之间没有法律上的因果关系，适用第 24 条的前提不成立",
      "holds": "yes",
      "groupId": "g-2",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-5",
      "kind": "judgement",
      "label": "一审依第 24 条适用公平原则判令杨帆补偿，属于适用法律错误",
      "holds": "yes",
      "groupId": "g-2",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-9",
      "kind": "fact",
      "label": "一审判决以段小立在与杨帆发生言语争执后猝死为由，判令杨帆补偿田九菊 15000 元",
      "groupId": "g-2",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "c-4",
      "kind": "conclusion",
      "label": "二审应当对一审判决改判",
      "holds": "yes",
      "groupId": "g-3"
    },
    {
      "id": "n-3",
      "kind": "norm",
      "label": "民诉法解释第 323 条：二审围绕上诉请求审理；但一审判决违反法律禁止性规定，或损害国家利益、社会公共利益、他人合法权益的除外",
      "groupId": "g-3",
      "sourceIds": [
        "s-5"
      ]
    },
    {
      "id": "n-4",
      "kind": "norm",
      "label": "郑州市有关规定：电梯间等公共场所禁止吸烟，公民有权制止",
      "groupId": "g-3",
      "sourceIds": [
        "s-7"
      ]
    },
    {
      "id": "n-6",
      "kind": "norm",
      "label": "民法的基本原则和立法宗旨：保护生态环境、维护社会公共利益和公序良俗，弘扬社会主义核心价值观",
      "groupId": "g-3",
      "sourceIds": [
        "s-8"
      ]
    },
    {
      "id": "e-5",
      "kind": "element",
      "label": "一审判决损害社会公共利益（二审可不受上诉请求限制的例外）",
      "holds": "yes",
      "groupId": "g-3"
    },
    {
      "id": "j-6",
      "kind": "judgement",
      "label": "杨帆劝阻吸烟合法正当，是自觉维护社会公共秩序和公共利益的行为",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "j-7",
      "kind": "judgement",
      "label": "让正当劝阻的公民分担损失，会挫伤公民维护公共利益的积极性，损害社会公共利益，与民法立法宗旨相悖",
      "holds": "yes",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    },
    {
      "id": "f-10",
      "kind": "fact",
      "label": "一审判决作出后，杨帆没有上诉",
      "groupId": "g-3",
      "sourceIds": [
        "s-2"
      ]
    }
  ],
