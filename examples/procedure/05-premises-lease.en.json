  "rules": [
    {
      "id": "r-1",
      "when": "Party A delivers the premises late",
      "then": "Party A pays liquidated damages for late delivery: 0.1% of the monthly rent per day",
      "outcome": "negative",
      "stageIds": [
        "st-1"
      ]
    },
    {
      "id": "r-2",
      "when": "Party A is more than 30 days late in delivering",
      "then": "Party B may rescind: Party A refunds rent and deposit and pays 3 months' rent",
      "outcome": "negative",
      "stageIds": [
        "st-1"
      ],
      "endId": "n-30"
    },
    {
      "id": "r-3",
      "when": "Party B pays rent late",
      "then": "Party B pays a late-payment penalty: 0.05% of the monthly rent per day",
      "outcome": "negative",
      "stageIds": [
        "st-2"
      ]
    },
    {
      "id": "r-4",
      "when": "Party B is more than 15 days late with rent",
      "then": "Party A may rescind: Party B pays 3 months' rent as damages (from the deposit), vacates and restores; items left are disposed of by Party A",
      "outcome": "negative",
