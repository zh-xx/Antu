  "rules": [
    {
      "id": "r-1",
      "when": "甲方逾期交付房屋",
      "then": "甲方支付逾期交付违约金：每日按当月租金 0.1%",
      "outcome": "negative",
      "stageIds": [
        "st-1"
      ]
    },
    {
      "id": "r-2",
      "when": "甲方逾期交付超过 30 日",
      "then": "乙方可解除合同：甲方退还租金押金并支付 3 个月租金赔偿",
      "outcome": "negative",
      "stageIds": [
        "st-1"
      ],
      "endId": "n-30"
    },
    {
      "id": "r-3",
      "when": "乙方逾期支付租金",
      "then": "乙方支付滞纳金：每日按当月租金 0.05%",
      "outcome": "negative",
      "stageIds": [
        "st-2"
      ]
    },
    {
      "id": "r-4",
      "when": "乙方逾期支付租金超过 15 日",
      "then": "甲方可解除合同：乙方支付 3 个月租金违约金（从押金抵扣），腾退并恢复原状，遗留物品由甲方处置",
      "outcome": "negative",
      "stageIds": [
        "st-2"
      ],
      "endId": "n-30"
