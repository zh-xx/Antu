  "rules": [
    {
      "id": "r-1",
      "when": "Material breach by Party A, uncured 30 days after Party B's notice",
      "then": "Party B may terminate: Party A refunds double the deposit and pays damages",
      "outcome": "negative",
      "stageIds": [
        "st-2"
      ],
      "endId": "n-31",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "r-2",
      "when": "Material breach by Party B, uncured 30 days after Party A's notice",
      "then": "Party A may terminate and forfeit the deposit",
      "outcome": "negative",
      "stageIds": [
        "st-2"
      ],
      "endId": "n-31",
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "r-3",
      "when": "Party A's representations and warranties prove untrue",
      "then": "Party B serves a damages notice within 30 days of discovery; if accepted Party A pays within 15 days, otherwise CIETAC arbitration",
      "outcome": "negative",
      "stageIds": [
        "st-2",
        "st-3",
        "st-4"
      ],
      "sourceIds": [
        "s-1"
      ]
    },
    {
      "id": "r-4",
      "when": "Party A breaches the non-compete or non-solicitation",
      "then": "Party A pays liquidated damages of RMB 50,000,000 and compensation",
      "outcome": "negative",
      "stageIds": [
        "st-4"
      ],
      "sourceIds": [
        "s-1"
      ]
    }
