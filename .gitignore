# Dependencies and build output
# no trailing slash: a symlink called node_modules must be ignored too (one was committed by mistake, #215)
node_modules
dist/
dist-engine/
dist-embed/
dist-api/
dist-cli/
dist-mcp/
dist-npm/
dist-html/
.verify/
build/
.vite/

# Generated diagrams: same name and folder as the source JSON, they are output and stay out of the repository
# (the example data itself is committed, as examples/**/*.json)
examples/**/*.html
# Local Mainline preview HTML under preview/ (fixtures stay tracked)
preview/**/*.html

# Logs and caches
*.log
.cache/
.tmp/

# Editor and system files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment and secrets (never commit)
.env
.env.local
*.pem
*.key

# Runs of the trial (tools/trial/run.mjs): kept on the machine, not in the repository
runs/
# Local DeepSeek probe transcripts under preview/ (fixtures stay tracked)
preview/**/deepseek-run/

# Case material drawn with Antu: stays on this machine, never in the repository
cases/

# Local verification screenshots / probes (once committed by mistake with #271; keep out)
evidence/
