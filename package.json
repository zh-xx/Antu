{
  "name": "antu",
  "version": "0.19.0",
  "license": "AGPL-3.0-or-later",
  "author": "Ji Cheng",
  "private": true,
  "description": "Antu · Legal Diagrams turns case JSON into one offline HTML diagram—timelines, procedures, relationships, and court reasoning—for AI agents and legal professionals.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:engine": "vite build --config vite.engine.config.js",
    "build:embed": "vite build --config vite.embed.config.js",
    "build:api": "vite build --config vite.api.config.js",
    "build:skill": "node tools/build-skill.mjs",
    "build:workbuddy": "node tools/workbuddy/build.mjs",
    "build:dsh": "node tools/dsh/build.mjs",
    "diagram": "node tools/make-html.mjs",
    "mcp": "node tools/mcp/server.mjs",
    "mcp:test": "node tools/mcp/client-test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.types.json --noEmit && tsc -p tsconfig.embed.json --noEmit && tsc -p tsconfig.dsh.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "verify": "node tools/verify/run.mjs",
    "verify:fast": "node tools/verify/run.mjs --no-browser",
    "test": "node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
