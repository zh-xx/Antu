{
  "name": "antu",
  "version": "0.11.0",
  "license": "AGPL-3.0-or-later",
  "author": "Ji Cheng",
  "private": true,
  "description": "Antu — a rendering core for legal work visualization. JSON specification plus an extensible rendering engine",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:engine": "vite build --config vite.engine.config.js",
    "build:embed": "vite build --config vite.embed.config.js",
    "build:api": "vite build --config vite.api.config.js",
    "build:skill": "node tools/build-skill.mjs",
    "diagram": "node tools/make-html.mjs",
    "mcp": "node tools/mcp/server.mjs",
    "mcp:test": "node tools/mcp/client-test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "node tools/verify/run.mjs",
    "verify:fast": "node tools/verify/run.mjs --no-browser",
    "test": "node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "vite": "^8.3.2"
  }
}
