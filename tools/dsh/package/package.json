{
  "name": "@zh-xx/antu-dsh",
  "version": "0.17.0",
  "description": "Antu diagrams inside DeepSeek Harness: Host tools (antu_validate / antu_layout / antu_render) and an interactive chat card.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.embed.js",
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "dependencies": {
    "@zh-xx/antu": "0.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2 || ^0.2.1-rc.0",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2 || ^0.2.1-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Ji Cheng",
  "homepage": "https://github.com/zh-xx/Antu/tree/main/tools/dsh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zh-xx/Antu.git",
    "directory": "tools/dsh"
  },
  "bugs": {
    "url": "https://github.com/zh-xx/Antu/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "legal",
    "diagram",
    "antu"
  ]
}
