{
  "mcpServers": {
    "antu": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "-p", "@zh-xx/antu@{{version}}", "antu-mcp"],
      "runtime": {
        "type": "node",
        "version": "20"
      },
      "npmRegistries": ["https://registry.npmmirror.com", "https://registry.npmjs.org"],
      "timeout": 60000
    }
  }
}
